			{{^{{FOOTNOTE 528}}}}[(v)  a  charitable  society  registered  under  the  Societies  Registration  Act  of  the relevant State;] {{^{{FOOTNOTE 529}}}}[(vi)] a company {{^{{FOOTNOTE 530}}}}[registered] under section 8 of the Companies Act, 2013 (18 of  2013)  {{^{{FOOTNOTE 531}}}}[including  a  company  registered  under  section  25  of  the repealed Companies Act, 1956];
